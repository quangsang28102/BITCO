# ==============================================================================
# SENSITIVE ENVIRONMENT & CREDENTIALS (BẢO MẬT & THÔNG TIN NHẠY CẢM)
# ==============================================================================
# WordPress configuration containing database credentials, salts, and secret keys
wp-config.php
app/public/wp-config.php
app/public/wp-config-local.php

# Local by Flywheel environment configuration
.env
.env.*
.envrc
app/.envrc

# Local server configurations (Nginx, PHP, MySQL)
conf/
app/conf/

# Server and debug logs
logs/
app/logs/
*.log

# Database dumps, exports and backups
app/sql/
*.sql
*.sql.gz
*.sqlite

